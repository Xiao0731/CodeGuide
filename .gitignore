# 模型权重（体积大，用 Git LFS 或外部存储）
checkpoints/
models/
outputs/
*.bin
*.safetensors
*.gguf

# 数据（原始数据不入库）
data/raw/
data/distilled/
data/cache/
data/final/
data/processed/
data/experts/
data/external/
data/splits/
!data/splits/
data/splits/*
!data/splits/sft_train_ids.json
!data/splits/sft_dev_ids.json
!data/splits/grpo_train_ids.json
!data/splits/grpo_validation_ids.json
!data/splits/sft_calibration_500_ids.json
data/*.parquet
