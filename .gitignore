data/tmp_*.py
# SFT JSONL 通过 manifest/hash 追踪，不提交 probe、smoke 或正式大文件。
data/sft_train*.jsonl
data/*.jsonl.tmp

# 实验日志
logs/
wandb/
artifacts/*
!artifacts/g0/
artifacts/g0/*
!artifacts/g0/environment.json
